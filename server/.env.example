# Copy to .env (loaded by `npm start` via --env-file-if-exists) or set these in
# the systemd unit. Nothing here has an insecure fallback any more: leave a
# secret blank and the server mints a random one rather than using a default.
PORT=3001

# Signing key for session tokens. Leave blank and one is generated on first boot
# and stored in the database — fine, but set it explicitly if you ever want to
# invalidate every session at once. `openssl rand -hex 32`
JWT_SECRET=

# System admin, seeded on first boot. Leave ADMIN_PASSWORD blank and a random
# one is generated and printed to the log ONCE — read it from the journal.
# Setting it later is honoured: the account is reconciled to match on boot.
ADMIN_EMAIL=admin@flinttask.com
ADMIN_PASSWORD=
ADMIN_NAME=System Admin

# Demo accounts (avery/jordan/sam/kai) share one password and avery is an ADMIN.
# They are seeded automatically in development only. In production they are
# skipped unless you opt in here — do not opt in on a public deployment.
SEED_DEMO_USERS=
DEMO_PASSWORD=

# Set to `production` on a real deployment: it gates demo-account seeding and
# turns on the boot-time warning about leftover demo accounts.
NODE_ENV=

# Where the SQLite file lives (defaults to ./data)
DATA_DIR=
