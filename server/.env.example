# Copy to .env (or set in the systemd unit) for production.
PORT=3001
# Long random string — `openssl rand -hex 32`
JWT_SECRET=
# System admin seeded on first boot
ADMIN_EMAIL=admin@flinttask.com
ADMIN_PASSWORD=
ADMIN_NAME=System Admin
# Shared password for the seeded demo accounts
DEMO_PASSWORD=
# Where the SQLite file lives (defaults to ./data)
DATA_DIR=
